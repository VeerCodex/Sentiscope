# ==========================================================
# Sentiment Analysis Platform - Environment Configuration
# ==========================================================

# Database Configuration
# Leave blank to use built-in local SQLite database automatically.
# To connect to Supabase, provide your project URL and service/anon key.
SUPABASE_URL=
SUPABASE_KEY=

# Google Places API Key (Optional: for fetching live Google business reviews)
GOOGLE_PLACES_API_KEY=

# App Settings
APP_NAME="Sentiment Analysis Software for Businesses"
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
